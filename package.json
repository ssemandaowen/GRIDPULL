{
  "name": "gridpull-cli",
  "version": "4.1.0",
  "description": "Native high-performance terminal media downloader, catalog search engine, and stream processing toolkit",
  "type": "module",
  "bin": {
    "gridpull": "./bin/gridpull.js"
  },
  "scripts": {
    "dev": "tsx bin/cli.ts",
    "build": "esbuild bin/cli.ts --bundle --minify --platform=node --format=esm --packages=external --sourcemap --outfile=dist/cli.mjs && node -e \"import('fs').then(fs => fs.writeFileSync('dist/cli.cjs', 'import(\\'./cli.mjs\\');'))\"",
    "start": "node bin/gridpull.js",
    "setup": "node bin/installer.js",
    "install:all": "node bin/installer.js",
    "postinstall": "node bin/installer.js",
    "cli": "node bin/gridpull.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "tsx --test test/tasks.test.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "dotenv": "^17.2.3",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "esbuild": "^0.25.0",
    "typescript": "~5.8.2"
  }
}